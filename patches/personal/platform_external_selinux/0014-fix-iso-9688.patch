+		if(strcmp(a_genfscon->fs_str, "exfat") == 0 ||
+			strcmp(a_genfscon->fs_str, "esdfs") == 0 ||
+			strcmp(a_genfscon->fs_str, "fuseblk") == 0 ||
+			strcmp(a_genfscon->fs_str, "iso9660") == 0 ||
+			strcmp(a_genfscon->fs_str, "udf") == 0) {
             if(strcmp(a_genfscon->path_str, "/") == 0)
                 bypass = 1;
         }
